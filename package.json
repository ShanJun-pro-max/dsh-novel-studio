{
  "name": "dsh-novel-workbench",
  "version": "3.4.2",
  "description": "小说工坊：DSH 的一页式小说创作工作台。章节看板、候选稿抽卡与合稿、素材回收站、偏好档案与类型库、剧情总结索引与别称识别、情节体检，以及读几本成品书提炼写法、写稿时照着用的成品书库。",
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "install.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/server/api.js"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.0.0",
    "@deepseek-ai/dsh-llm": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "novel",
    "writing",
    "chinese",
    "web-novel",
    "写作",
    "网文",
    "小说"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShanJun-pro-max/dsh-novel-workbench.git"
  },
  "homepage": "https://github.com/ShanJun-pro-max/dsh-novel-workbench#readme",
  "bugs": {
    "url": "https://github.com/ShanJun-pro-max/dsh-novel-workbench/issues"
  }
}
